# ─────────────────────────────
#  DreameHome — cloud connector (off-network: no IP, never pinged)
#  Copy to .env to override. Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (key = dir name)
NODE_NAME=DreameHome

# Optional. Web page for this connector, opened from the node drawer's link button.
# Full URL including scheme; blank hides the button.
WEB_URL=
