# ─────────────────────────────
#  Dropbox — cloud connector (off-network: no IP, never pinged)
#  Operator-named node: name the dir after whatever storage you use (nextcloud,
#  gdrive, ...) -- the dir name is the node key and its chat @handle.
#  Copy to .env to override. Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (key = dir name)
NODE_NAME=Dropbox

# Optional. Web page for this connector, opened from the node drawer's link button.
# Full URL including scheme; blank hides the button.
# e.g. https://www.dropbox.com/home/Apps/<your-app-folder>
WEB_URL=

# -- Credentials ---------------------------------------------------------------
# Dropbox is OAuth 2 only: there is no durable API key. Get these THREE once with
#   python3 scripts/dropbox_auth.py
# The refresh token does not expire, so the API mints access tokens by itself and
# this keeps working unattended. Set the app's scopes BEFORE authorising:
# files.metadata.read (list), files.content.read (import), files.content.write (sync)
# -- already-issued credentials keep their old scopes.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Fallback only, used when the three above are blank: a token pasted straight from
# the App Console. It expires ~4h after issue (the 'sl.' prefix marks a short-lived
# token), so it suits a quick test and nothing else.
DROPBOX_TOKEN=
