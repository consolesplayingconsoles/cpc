# ─────────────────────────────
#  Game Boy Advance — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity
NODE_NAME="Game Boy Advance"
MANUFACTURER=Nintendo

# Network
# The GBA has no network of its own: it is reached through the Pi hub, so HOST_IP is
# host:port pointing at the hub's health server for this node. Pluto does TCP + GET
# /health there instead of ICMP: 200 = this console's card is in the Pi, 503 = it is not.
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=
# SMB_PATH enables the FILES button in Pluto. Include auth in the URL if needed:
# guest:  smb://guest:@hostname
# authed: smb://user:password@hostname
SMB_PATH=
# SSH: set CUSTOM_SSH_ALIAS (ssh-config entry) OR SSH_USER + SSH_KEY_PATH.
# Having either enables the DEPLOY button in Pluto. Omit both for a files-only
# node (e.g. a third-party distro you don't deploy the TUI to).
CUSTOM_SSH_ALIAS=
SSH_USER=
SSH_KEY_PATH=~/.ssh/id_rsa

# UI Branding (hex, e.g. #00FF88)
UI_PRIMARY_COLOR=#6040A0
UI_SECONDARY_COLOR=#3D2870

# SD_LABEL: volume label of this console's SD/flash card (e.g. GBA). The Pi finds it
# under /dev/disk/by-label/, so it does not matter which device node it lands on.
# Set = the SD back-up button appears on this node; blank = no card, button hidden.
SD_LABEL=

# SD_ROMS_DIR: where the games sit on that card, relative to its root ("." = the root,
# folders and all). Blank = Pluto only backs the card up, it never catalogues its games.
SD_ROMS_DIR=
# SD_NAME_STRIP: optional regex cut out of a path before a title is read, for a card that
# decorates its file names (e.g. "(?<=ROM A-Z/)[0-9]{3}\s" drops "157 " from
# "157 Golden Axe Warrior (USA, Europe).sms"). The files keep their names.
SD_NAME_STRIP=
# SD_SEND_SYSTEMS: which consoles "Send all" may copy here (blank = any this node serves).
SD_SEND_SYSTEMS=
# SD_SEND_DIRS: where copies land per console, when reading is card-wide but writing is
# not: "mastersystem:ROM A-Z,sg1000:ROM- SG1000 SC3000". Unlisted = SD_ROMS_DIR.
SD_SEND_DIRS=
