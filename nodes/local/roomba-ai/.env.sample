# Firefox OS handset riding the roomba: video and audio I/O node.
#
# Copy to .env and fill in the values. Only *.env.sample is committed.
#
# The handset carries two planes. CONTROL is the Firefox Remote Debugging
# Protocol over adb (install, launch and steer the media app, read state).
# MEDIA is a WebSocket between the app on the handset and the brain (camera
# and mic up, screen and speaker down). They are separate on purpose: RDP is
# a JSON control protocol and is no place for frames.

# Identity
NODE_NAME=Roomba AI

# Control target group: subtarget of the "roomba" target in the Control rail,
# alongside roomba-rally.
CONTROL_TARGET=roomba

# Network. The handset joins wifi and is pinged like any other LAN node.
# Assign it a static lease so it does not move under you.
HOST_IP=

# CONTROL PLANE
# adbd listens on ADB_TCP_PORT once switched to TCP mode (client.enable_tcpip(),
# run once over USB). DEBUGGER_PORT is the LOCAL port on the Pluto host that adb
# forwards to the handset's debugger socket, not a port on the handset.
ADB_TCP_PORT=5555
DEBUGGER_PORT=6000

# MEDIA PLANE
# Where the brain listens for the handset's WebSocket. Set BRAIN_HOST to the
# laptop or the Pi depending on which one is running the brain.
BRAIN_HOST=
BRAIN_PORT=7726

# UI Branding (hex)
UI_PRIMARY_COLOR=#FF9500
UI_SECONDARY_COLOR=#8C5200
