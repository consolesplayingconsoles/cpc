# ─────────────────────────────
#  Master System — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "sms")
NODE_NAME=Master System
MANUFACTURER=Sega

# Network
# HOST_IP: the Master System has no IP of its own, so it reaches Pluto through the Pi
# hub on its own port, as <pi_ip>:<port> (7722 megadrive, 7723 saturn, 7724 here,
# 7725 gba). Set = the node is on the map, and Pluto probes GET /health there; empty =
# stripped from the map. Only the megadrive port is served today, so the others render
# offline until the hub answers them.
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=

# UI Branding (hex)
UI_PRIMARY_COLOR=#1F6FB5
UI_SECONDARY_COLOR=#14456F

# The Master System EverDrive card, read through the Pi hub. SD_LABEL is the card's
# volume label; SD_ROMS_DIR is where its games sit ("." = the card root, folders and
# all); SD_NAME_STRIP is a regex cut out of a path before a title is read, for a card
# that decorates its file names; SD_SEND_SYSTEMS limits what "Send all" may copy here;
# SD_SEND_DIRS says where copies land, per console and/or per kind ("tool:<folder>"
# keeps tools apart; files in that folder are scanned as tools).
SD_LABEL=
SD_ROMS_DIR=
SD_NAME_STRIP=
SD_SEND_SYSTEMS=
SD_SEND_DIRS=
