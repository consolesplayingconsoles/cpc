# ─────────────────────────────
#  NAOMI — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "naomi")
NODE_NAME=Naomi
MANUFACTURER=Sega

# Network
# The bare board has no network at all: it is reached through the Pi, which speaks JVS
# to it over a USB-RS485 dongle (the `openjvs` service, declared in nodes/local/pi/
# services.json and tagged as serving this node). Leave HOST_IP blank until the board
# has a network of its own.
#
# A Net DIMM changes that: the DIMM board has its own ethernet and answers on the LAN,
# so once one is fitted set HOST_IP to the DIMM's address and the node becomes a real
# pinged node like any other.
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=

# UI Branding (hex)
UI_PRIMARY_COLOR=#E8752C
UI_SECONDARY_COLOR=#8A4316
