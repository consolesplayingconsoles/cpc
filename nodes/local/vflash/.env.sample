# ─────────────────────────────
#  V.Flash — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "vflash")
NODE_NAME=V.Flash
MANUFACTURER=VTech

# Network
# The V.Flash has no network of its own. Empty = unconfigured on the map; the homebrew
# and the Media library run on the Lab in RetroArch (FlashEm core).
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=

# UI Branding (hex, e.g. #00FF88)
UI_PRIMARY_COLOR=#3050A8
UI_SECONDARY_COLOR=#1E3470
