# Pluto virtual pad (pluto-drive NaomiSink, uinput). Codes are chosen by that sink,
# so this file and controller.py NaomiSink._CODES must agree.
#
# PLAYER 1 pins it instead of letting OpenJVS hand it the next free player number --
# otherwise this pad becomes player 2 and a coin lands on the wrong slot.
PLAYER 1

BTN_THUMBR CONTROLLER_BUTTON_COIN
BTN_MODE   CONTROLLER_BUTTON_TEST
BTN_SELECT CONTROLLER_BUTTON_SERVICE
BTN_START  CONTROLLER_BUTTON_START

BTN_TRIGGER CONTROLLER_BUTTON_A
BTN_THUMB   CONTROLLER_BUTTON_B
BTN_THUMB2  CONTROLLER_BUTTON_C
BTN_TOP     CONTROLLER_BUTTON_D
BTN_TOP2    CONTROLLER_BUTTON_E
BTN_PINKIE  CONTROLLER_BUTTON_F

BTN_DPAD_UP    CONTROLLER_BUTTON_UP
BTN_DPAD_DOWN  CONTROLLER_BUTTON_DOWN
BTN_DPAD_LEFT  CONTROLLER_BUTTON_LEFT
BTN_DPAD_RIGHT CONTROLLER_BUTTON_RIGHT
