# -----------------------------
#  PlayStation 2 -- environment template
#  Copy to .env and fill in the values.
#  Only *.env.sample is committed; never .env.
# -----------------------------

# Identity (the node key is the dir name: "ps2")
NODE_NAME=PlayStation 2
MANUFACTURER=Sony

# Network
# The PS2 has no network: games reach it on its internal HDD (PS2 APA format, formatted by
# FMCB), on a USB-SATA adapter. Blank = not pinged.
HOST_IP=

# PS2 HDD installs (scripts/ps2hdd.py, run where the drive is plugged in)
# PS2_HDD_HOST: SSH alias of the machine the drive is plugged into (e.g. the Pi hub, `pipc`).
# Pluto then drives it itself, no Terminal command: Sync runs ps2hdd.py list there, Send runs
# scripts/ps2hdd-hub.py here, which sends the games and installs them there. ps2hdd.py is
# shipped by the Pi's ps2 deploy payload and runs under passwordless sudo.
# Blank = the drive is plugged into this Mac (Pluto hands out `sudo ps2hdd.py` commands).
PS2_HDD_HOST=
# PS2_GAMES_PATH: where your PS2 games sit on this Mac (.iso, .cue/.bin, .chd, .7z/.zip).
PS2_GAMES_PATH=
# PS2_HDD_BYTES: exact size of the PS2 drive in bytes (`diskutil info diskN` "Disk Size",
# Linux `lsblk -b -d`).
# Only an external USB disk of exactly this size, with a PS2 APA header, is ever written.
PS2_HDD_BYTES=
# PS2_HDD_WORK_PATH: disc-ID cache, header backups and temp files (converted CD images and
# read-back checks need up to twice the largest game free here).
PS2_HDD_WORK_PATH=
# PS2_HDD_WORK_PATH and HDL_DUMP are on the machine the drive is plugged into; with
# PS2_HDD_HOST the host's work dir is removed after each run, backups come back here.
# HDL_DUMP: path to the hdl_dump binary (build it with scripts/build-hdl-dump.sh there).
HDL_DUMP=
# PLUTO_API: the Lab API the script reports the drive's game list to, as seen from the
# machine the drive is plugged into (e.g. http://localhost:7700, or http://<mac ip>:7700).
PLUTO_API=

# UI Branding (hex)
UI_PRIMARY_COLOR=#2E4FA3
UI_SECONDARY_COLOR=#1C2F66
