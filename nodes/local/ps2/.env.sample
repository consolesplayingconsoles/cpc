# -----------------------------
#  PlayStation 2 -- environment template
#  Copy to .env and fill in the values.
#  Only *.env.sample is committed; never .env.
# -----------------------------

# Identity (the node key is the dir name: "ps2")
NODE_NAME=PlayStation 2
MANUFACTURER=Sony

# Network
# The PS2 has no network: games reach it on its internal HDD (PS2 APA format, formatted by
# FMCB), plugged into this Mac over a USB-SATA adapter. Blank = not pinged.
HOST_IP=

# PS2 HDD installs (scripts/ps2hdd.py)
# PS2_GAMES_PATH: where your PS2 games sit on this Mac (.iso, .cue/.bin, .chd, .7z/.zip).
PS2_GAMES_PATH=
# PS2_HDD_BYTES: exact size of the PS2 drive in bytes (`diskutil info diskN`, "Disk Size").
# Only an external USB disk of exactly this size, with a PS2 APA header, is ever written.
PS2_HDD_BYTES=
# PS2_HDD_WORK_PATH: disc-ID cache, header backups and temp files (converted CD images and
# read-back checks need up to twice the largest game free here).
PS2_HDD_WORK_PATH=
# HDL_DUMP: path to the hdl_dump binary (build it with scripts/build-hdl-dump.sh).
HDL_DUMP=
# PLUTO_API: the Lab API the script reports the drive's game list to (e.g. http://localhost:7700).
PLUTO_API=

# UI Branding (hex)
UI_PRIMARY_COLOR=#2E4FA3
UI_SECONDARY_COLOR=#1C2F66
