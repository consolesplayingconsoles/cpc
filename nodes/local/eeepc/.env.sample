# ─────────────────────────────
#  Eee PC — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "eeepc")
NODE_NAME=Eee PC
MANUFACTURER=ASUS

# Network
# The Eee PC's LAN IP; status is a live ping like any other device.
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=
# SSH: the ~/.ssh/config Host alias for this machine (or SSH_USER + SSH_KEY_PATH).
CUSTOM_SSH_ALIAS=
SSH_USER=
SSH_KEY_PATH=~/.ssh/eeepc

# SMB_PATH: the share this node serves (FILES button), e.g. smb://guest:<password>/<host>/<share>
SMB_PATH=

# UI Branding (hex)
UI_PRIMARY_COLOR=#5B7083
UI_SECONDARY_COLOR=#3A4A5A
