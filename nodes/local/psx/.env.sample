# ─────────────────────────────
#  PlayStation — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "psx")
NODE_NAME=PlayStation
MANUFACTURER=Sony

# Network
# The console has no network of its own. Like the Saturn and the Mega Drive, it reaches
# the network through the Pi hub: set HOST_IP to host:port of the hub's health server for
# this node and Pluto does a TCP connect + GET /health instead of an ICMP ping, so
# liveness means "its storage is reachable", NOT "the console is powered".
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=

# SD_LABEL: volume label of this console's card, if it runs from one (an ODE or flash
# cart). The Pi finds it by label under /dev/disk/by-label/, so the device node does not
# matter. Set = the SD back-up button appears; blank = no card, button hidden.
SD_LABEL=
# SD_ROMS_DIR: where the games sit on that card. Set = the Media catalogue scans it
# through the Pi hub (read-only); blank = saves back-up only.
SD_ROMS_DIR=

# UI Branding (hex)
UI_PRIMARY_COLOR=#8C8C94
UI_SECONDARY_COLOR=#4A4A52
