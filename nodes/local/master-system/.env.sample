# ─────────────────────────────
#  Master System — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "master-system")
NODE_NAME=Master System
MANUFACTURER=Sega

# Network
# HOST_IP: the Master System has no IP of its own. Leave empty until it reaches
# the network through a Pico on the Pi hub, the way the Mega Drive does; then
# point this at the hub's health server as <pi_ip>:<port> so Pluto can tell
# powered from off. Empty = not on the map.
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=

# UI Branding (hex)
UI_PRIMARY_COLOR=#1F6FB5
UI_SECONDARY_COLOR=#14456F
