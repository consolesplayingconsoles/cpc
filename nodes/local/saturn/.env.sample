# ─────────────────────────────
#  Saturn — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "saturn")
NODE_NAME=Saturn
MANUFACTURER=Sega

# Network
# The Saturn has no network of its own: it reaches the network through the Pi hub, so
# HOST_IP is host:port pointing at the hub's health server for this node (the Mega Drive
# does the same). Pluto does a TCP connect + GET /health there instead of an ICMP ping:
# 200 = this console's SD card is plugged into the Pi, 503 = it is not. Liveness here
# therefore means "its storage is reachable", NOT "the console is powered".
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=

# SD_LABEL: volume label of this console's SD card (e.g. SAROO). The Pi finds the card
# by label under /dev/disk/by-label/, so it does not matter which device node it gets.
# Set = the SD back-up button appears on this node; blank = no SD, button hidden.
SD_LABEL=

# UI Branding (hex)
UI_PRIMARY_COLOR=#2A6BB0
UI_SECONDARY_COLOR=#1B4570
