# ─────────────────────────────
#  Mega Drive — environment template
#  Copy to .env (or dev.env / prod.env) and fill in the values.
#  Only *.env.sample is committed; never .env.
# ─────────────────────────────

# Identity (the node key is the dir name: "smd")
NODE_NAME=Mega Drive
MANUFACTURER=Sega

# Network
# HOST_IP: the Mega Drive has no IP of its own -- it reaches the network through the
# genesis datalink Pico on the Pi hub. Point this at the hub's health server as
# <pi_ip>:<port> (e.g. 192.168.68.60:7722, matching the Pi's PI_MD_HEALTH_PORT). Pluto
# then does a TCP + GET /health there instead of an ICMP ping: up = the console is
# actually powered (the Pico sees SELECT toggling), down = off. Empty = not on the map.
HOST_IP=
# PLUTO_IP: IP of the machine running the Pluto dashboard (api.py).
# Set to enable the Chat menu item. Leave empty to hide it.
PLUTO_IP=

# SD_LABEL: volume label of the flashcart's SD card (e.g. EDMD). The Pi finds the card by
# label under /dev/disk/by-label/. Set = the SD back-up button appears; blank = hidden.
SD_LABEL=
# SD_ROMS_DIR: where the games sit on the card, "." = the whole card. Set = the Media
# catalogue scans it through the Pi hub (read-only). Files go to Mega Drive, or to Master
# System by extension (config/consoles.json systems.mastersystem.extensions). Also where the
# Media tab's Send copies games (canonical file names).
SD_ROMS_DIR=
# SD_SEND_SYSTEMS: comma list of the systems Send may copy to the card; blank = all it hosts.
SD_SEND_SYSTEMS=
# SD_SEND_DIRS: a folder per kind and/or console, e.g. "tool:Mega Drive/Tools" keeps tools out
# of the games folder. A kind wins over a console; unlisted = SD_ROMS_DIR. Files already in a
# kind's folder are scanned as that kind.
SD_SEND_DIRS=tool:Mega Drive/Tools,mod:Mega Drive/Mods
# A cart menu indexes one directory at a time (the EverDrive-MD OS tops out near 200
# files, then the browser garbles and sorts at random), so games split into these
# letter folders; mods all sit in Mods/, named "<game> - <mod>" so a game.s mods group.
SD_SEND_RANGES=

# UI Branding (hex)
UI_PRIMARY_COLOR=#C0392B
UI_SECONDARY_COLOR=#7E2520
